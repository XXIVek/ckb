<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xr="http://v8.1c.ru/8.3/xcf/readable"
    targetNamespace="http://v8.1c.ru/8.3/MDClasses"
    elementFormDefault="qualified">

    <!-- InternalInfo — внутренняя информация объекта -->
    <xs:complexType name="InternalInfoType">
        <xs:sequence>
            <xs:element name="ContainedObject" type="xr:ContainedObjectType"/>
            <xs:element name="GeneratedType" type="xr:GeneratedTypeType"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ContainedObject — ссылка на класс объекта -->
    <xs:complexType name="ContainedObjectType">
        <xs:sequence>
            <xs:element name="ClassId" type="xs:string"/>
            <xs:element name="ObjectId" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- GeneratedType — сгенерированный тип объекта -->
    <xs:complexType name="GeneratedTypeType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="category" type="xs:string"/>
            <xs:element name="TypeId" type="xs:string"/>
            <xs:element name="ValueId" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
