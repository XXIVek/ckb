<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xr="http://v8.1c.ru/8.3/xcf/readable"
    targetNamespace="http://v8.1c.ru/8.3/MDClasses"
    elementFormDefault="qualified">

    <!-- ExchangePlan — План обмена -->
    <xs:element name="ExchangePlan" type="xr:ExchangePlanType"/>

    <xs:complexType name="ExchangePlanType">
        <xs:sequence>
            <xs:element name="InternalInfo" type="xr:InternalInfoType"/>
            <xs:element name="Properties" type="xr:ExchangePlanPropertiesType"/>
            <xs:element name="ChildObjects" type="xr:ExchangePlanChildObjectType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="uuid" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Properties плана обмена -->
    <xs:complexType name="ExchangePlanPropertiesType">
        <xs:sequence>
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="Synonym" type="xr:SynonymType" minOccurs="0"/>
            <xs:element name="Comment" type="xs:string" minOccurs="0"/>
            <!-- Режим обмена -->
            <xs:element name="ExchangeProvisions" type="xr:ExchangeProvisionsType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
