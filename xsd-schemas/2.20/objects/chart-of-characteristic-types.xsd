<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xr="http://v8.1c.ru/8.3/xcf/readable"
    targetNamespace="http://v8.1c.ru/8.3/MDClasses"
    elementFormDefault="qualified">

    <!-- ChartOfCharacteristicTypes — План видов характеристик -->
    <xs:element name="ChartOfCharacteristicTypes" type="xr:ChartOfCharacteristicTypesType"/>

    <xs:complexType name="ChartOfCharacteristicTypesType">
        <xs:sequence>
            <xs:element name="InternalInfo" type="xr:InternalInfoType"/>
            <xs:element name="Properties" type="xr:CCTPropertiesType"/>
        </xs:sequence>
        <xs:attribute name="uuid" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Properties ПВХ -->
    <xs:complexType name="CCTPropertiesType">
        <xs:sequence>
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="Synonym" type="xr:SynonymType" minOccurs="0"/>
            <xs:element name="Comment" type="xs:string" minOccurs="0"/>
            <!-- Кодировка -->
            <xs:element name="CodeLength" type="xs:int" minOccurs="0"/>
            <xs:element name="DescriptionLength" type="xs:int" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
