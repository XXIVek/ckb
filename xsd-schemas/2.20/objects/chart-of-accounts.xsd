<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xr="http://v8.1c.ru/8.3/xcf/readable"
    targetNamespace="http://v8.1c.ru/8.3/MDClasses"
    elementFormDefault="qualified">

    <!-- ChartOfAccounts — План счетов -->
    <xs:element name="ChartOfAccounts" type="xr:ChartOfAccountsType"/>

    <xs:complexType name="ChartOfAccountsType">
        <xs:sequence>
            <xs:element name="InternalInfo" type="xr:InternalInfoType"/>
            <xs:element name="Properties" type="xr:ChartOfAccountsPropertiesType"/>
            <xs:element name="ChildObjects" type="xr:ChartOfAccountsChildObjectType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="uuid" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Properties плана счетов -->
    <xs:complexType name="ChartOfAccountsPropertiesType">
        <xs:sequence>
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="Synonym" type="xr:SynonymType" minOccurs="0"/>
            <xs:element name="Comment" type="xs:string" minOccurs="0"/>
            <!-- Кодировка -->
            <xs:element name="CodeLength" type="xs:int" minOccurs="0"/>
            <xs:element name="DescriptionLength" type="xs:int" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
