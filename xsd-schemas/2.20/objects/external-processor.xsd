<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xr="http://v8.1c.ru/8.3/xcf/readable"
    xmlns:v8="http://v8.1c.ru/8.1/data/core"
    targetNamespace="http://v8.1c.ru/8.3/MDClasses"
    elementFormDefault="qualified">

    <!-- ExternalDataProcessor — внешняя обработка -->
    <xs:element name="ExternalDataProcessor" type="xr:ExternalDataProcessorType"/>

    <xs:complexType name="ExternalDataProcessorType">
        <xs:sequence>
            <xs:element name="InternalInfo" type="xr:InternalInfoType"/>
            <xs:element name="Properties" type="xr:ExternalDataProcessorPropertiesType"/>
            <xs:element name="ChildObjects" type="xr:ExternalDataProcessorChildObjectType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="uuid" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Properties внешней обработки -->
    <xs:complexType name="ExternalDataProcessorPropertiesType">
        <xs:sequence>
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="Synonym" type="xr:SynonymType" minOccurs="0"/>
            <xs:element name="Comment" type="xs:string" minOccurs="0"/>
            <!-- Ссылка на основную форму -->
            <xs:element name="DefaultForm" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ChildObjects внешней обработки -->
    <xs:complexType name="ExternalDataProcessorChildObjectType">
        <xs:choice maxOccurs="unbounded">
            <!-- Реквизиты объекта -->
            <xs:element name="Attribute" type="xr:ObjectAttributeType"/>
            <!-- Табличные части -->
            <xs:element name="TabularSection" type="xr:TabularSectionType"/>
            <!-- Формы (ссылка по имени) -->
            <xs:element name="Form" type="xs:string"/>
            <!-- Макеты (ссылка по имени) -->
            <xs:element name="Template" type="xs:string"/>
        </xs:choice>
    </xs:complexType>

</xs:schema>
