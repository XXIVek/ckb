<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xr="http://v8.1c.ru/8.3/xcf/readable"
    targetNamespace="http://v8.1c.ru/8.3/MDClasses"
    elementFormDefault="qualified">

    <!-- AccumulationRegister — Регистр накопления -->
    <xs:element name="AccumulationRegister" type="xr:AccumulationRegisterType"/>

    <xs:complexType name="AccumulationRegisterType">
        <xs:sequence>
            <xs:element name="InternalInfo" type="xr:InternalInfoType"/>
            <xs:element name="Properties" type="xr:AccumulationRegisterPropertiesType"/>
            <xs:element name="ChildObjects" type="xr:AccumulationRegisterChildObjectType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="uuid" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Properties регистра накопления -->
    <xs:complexType name="AccumulationRegisterPropertiesType">
        <xs:sequence>
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="Synonym" type="xr:SynonymType" minOccurs="0"/>
            <xs:element name="Comment" type="xs:string" minOccurs="0"/>
            <!-- Тип записи -->
            <xs:element name="RecordType" type="xr:RecordTypeEnumType" minOccurs="0"/>
            <!-- Проведение -->
            <xs:element name="PostMode" type="xr:PostModeType" minOccurs="0"/>
            <xs:element name="MovementMode" type="xr:MovementModeType" minOccurs="0"/>
            <!-- Стандартные реквизиты -->
            <xs:element name="StandardAttributes" type="xr:StandardAttributesType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ChildObjects регистра накопления -->
    <xs:complexType name="AccumulationRegisterChildObjectType">
        <xs:choice maxOccurs="unbounded">
            <!-- Измерения -->
            <xs:element name="Dimension" type="xr:DimensionType"/>
            <!-- Ресурсы -->
            <xs:element name="Resource" type="xr:ResourceType"/>
        </xs:choice>
    </xs:complexType>

</xs:schema>
