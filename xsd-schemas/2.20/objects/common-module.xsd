<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xr="http://v8.1c.ru/8.3/xcf/readable"
    targetNamespace="http://v8.1c.ru/8.3/MDClasses"
    elementFormDefault="qualified">

    <!-- CommonModule — Общий модуль -->
    <xs:element name="CommonModule" type="xr:CommonModuleType"/>

    <xs:complexType name="CommonModuleType">
        <xs:sequence>
            <xs:element name="InternalInfo" type="xr:InternalInfoType"/>
            <xs:element name="Properties" type="xr:CommonModulePropertiesType"/>
        </xs:sequence>
        <xs:attribute name="uuid" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Properties общего модуля -->
    <xs:complexType name="CommonModulePropertiesType">
        <xs:sequence>
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="Synonym" type="xr:SynonymType" minOccurs="0"/>
            <xs:element name="Comment" type="xs:string" minOccurs="0"/>
            <!-- Режим -->
            <xs:element name="Server" type="xr:ModuleServerModeType" minOccurs="0"/>
            <xs:element name="ServerExternalConnections" type="xs:boolean" minOccurs="0"/>
            <xs:element name="MobileServer" type="xr:ModuleServerModeType" minOccurs="0"/>
            <xs:element name="MobileServerExternalConnections" type="xs:boolean" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
