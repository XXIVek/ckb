<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xr="http://v8.1c.ru/8.3/xcf/readable"
    targetNamespace="http://v8.1c.ru/8.3/MDClasses"
    elementFormDefault="qualified">

    <!-- Constant — Константа -->
    <xs:element name="Constant" type="xr:ConstantType"/>

    <xs:complexType name="ConstantType">
        <xs:sequence>
            <xs:element name="InternalInfo" type="xr:InternalInfoType"/>
            <xs:element name="Properties" type="xr:ConstantPropertiesType"/>
        </xs:sequence>
        <xs:attribute name="uuid" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Properties константы -->
    <xs:complexType name="ConstantPropertiesType">
        <xs:sequence>
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="Synonym" type="xr:SynonymType" minOccurs="0"/>
            <xs:element name="Comment" type="xs:string" minOccurs="0"/>
            <!-- Тип константы -->
            <xs:element name="Type" type="xr:AttributeValueType" minOccurs="0"/>
            <!-- Текущее значение -->
            <xs:element name="CurrentValue" type="xs:string" minOccurs="0"/>
            <!-- Историческое значение -->
            <xs:element name="HistoryValues" type="xs:boolean" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
