<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xr="http://v8.1c.ru/8.3/xcf/readable"
    targetNamespace="http://v8.1c.ru/8.3/MDClasses"
    elementFormDefault="qualified">

    <!-- ExternalReport — внешний отчёт -->
    <xs:element name="ExternalReport" type="xr:ExternalReportType"/>

    <xs:complexType name="ExternalReportType">
        <xs:sequence>
            <!-- InternalInfo обязателен для всех объектов метаданных -->
            <xs:element name="InternalInfo" type="xr:InternalInfoType"/>
            <!-- Properties — основные свойства объекта -->
            <xs:element name="Properties" type="xr:ExternalReportPropertiesType"/>
            <!-- ChildObjects — дочерние объекты (опционально) -->
            <xs:element name="ChildObjects" type="xr:ExternalReportChildObjectType" minOccurs="0"/>
        </xs:sequence>
        <!-- uuid обязателен для всех MDObject -->
        <xs:attribute name="uuid" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Properties внешнего отчета -->
    <xs:complexType name="ExternalReportPropertiesType">
        <xs:sequence>
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="Synonym" type="xr:SynonymType" minOccurs="0"/>
            <xs:element name="Comment" type="xs:string" minOccurs="0"/>
            <!-- Ссылки на формы -->
            <xs:element name="DefaultForm" type="xs:string" minOccurs="0"/>
            <xs:element name="AuxiliaryForm" type="xs:string" minOccurs="0"/>
            <!-- Схема СКД -->
            <xs:element name="MainDataCompositionSchema" type="xs:string" minOccurs="0"/>
            <!-- Формы настроек -->
            <xs:element name="DefaultSettingsForm" type="xs:string" minOccurs="0"/>
            <xs:element name="AuxiliarySettingsForm" type="xs:string" minOccurs="0"/>
            <xs:element name="DefaultVariantForm" type="xs:string" minOccurs="0"/>
            <!-- Хранилища вариантов и настроек -->
            <xs:element name="VariantsStorage" type="xr:DataCompositionSchemaRefType" minOccurs="0"/>
            <xs:element name="SettingsStorage" type="xr:SettingsStorageRefType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ChildObjects внешнего отчета -->
    <xs:complexType name="ExternalReportChildObjectType">
        <xs:choice maxOccurs="unbounded">
            <!-- Реквизиты объекта -->
            <xs:element name="Attribute" type="xr:ObjectAttributeType"/>
            <!-- Табличные части -->
            <xs:element name="TabularSection" type="xr:TabularSectionType"/>
            <!-- Формы (ссылка по имени) -->
            <xs:element name="Form" type="xs:string"/>
            <!-- Макеты (ссылка по имени) -->
            <xs:element name="Template" type="xs:string"/>
        </xs:choice>
    </xs:complexType>

</xs:schema>
