<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xr="http://v8.1c.ru/8.3/xcf/readable"
    targetNamespace="http://v8.1c.ru/8.3/MDClasses"
    elementFormDefault="qualified">

    <!-- AccountingRegister — Регистр бухгалтерии -->
    <xs:element name="AccountingRegister" type="xr:AccountingRegisterType"/>

    <xs:complexType name="AccountingRegisterType">
        <xs:sequence>
            <xs:element name="InternalInfo" type="xr:InternalInfoType"/>
            <xs:element name="Properties" type="xr:AccountingRegisterPropertiesType"/>
            <xs:element name="ChildObjects" type="xr:AccountingRegisterChildObjectType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="uuid" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Properties регистра бухгалтерии -->
    <xs:complexType name="AccountingRegisterPropertiesType">
        <xs:sequence>
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="Synonym" type="xr:SynonymType" minOccurs="0"/>
            <xs:element name="Comment" type="xs:string" minOccurs="0"/>
            <!-- План счетов -->
            <xs:element name="ChartOfAccounts" type="xs:string" minOccurs="0"/>
            <!-- Корреспонденция -->
            <xs:element name="Correspondence" type="xs:boolean" minOccurs="0"/>
            <!-- Стандартные реквизиты -->
            <xs:element name="StandardAttributes" type="xr:StandardAttributesType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
