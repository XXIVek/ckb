<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xr="http://v8.1c.ru/8.3/xcf/readable"
    targetNamespace="http://v8.1c.ru/8.3/MDClasses"
    elementFormDefault="qualified">

    <!-- Макет (ссылка в ChildObjects) -->
    <xs:element name="Template" type="xs:string"/>

    <!-- Метаданные макета — отдельный XML файл Templates/&lt;Имя&gt;.xml -->
    <xs:element name="TemplateMeta" type="xr:TemplateMetaType"/>

    <xs:complexType name="TemplateMetaType">
        <xs:sequence>
            <xs:element name="Properties" type="xr:TemplateMetaPropertiesType"/>
        </xs:sequence>
        <xs:attribute name="uuid" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="TemplateMetaPropertiesType">
        <xs:sequence>
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="Synonym" type="xr:SynonymType" minOccurs="0"/>
            <xs:element name="Comment" type="xs:string" minOccurs="0"/>
            <!-- Тип макета -->
            <xs:element name="TemplateType" type="xr:TemplateTypeEnumType" minOccurs="0"/>
            <!-- Расширение тела -->
            <xs:element name="ContentExtension" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
