# --- Артефакты проверок (логи прогонов, дампы SQL, извлечённые модули форм) ---
# Постоянные проверочные скрипты (_cmp_ddl.py, _v13_mcp_layer.py, validate_*.py) трекаются,
# а их вывод остаётся локально: это доказательства прогонов, а не исходники.
_v*.txt
_v*.bsl
_v*.err
_inv_out.txt
# Пробы ibcmd: лог прогонов и рабочие каталоги (в том числе созданная ИБ-заготовка ~3.5 МБ).
# Сам скрипт _ibcmd_probe.py трекается — он воспроизводит замеры (раздел 13 плана).
_ibcmd_probe_out.txt
_ibcmd_work/
# Извлечённый текст .docx-статьи (раздел 13.5 плана). Сам экстрактор _docx_extract.py трекается:
# load_doc_tool понимает только .html, поэтому извлечение - штатный шаг загрузки (.docx, .md).
_docx_*.txt
# Лог прогона tools/load_its_pdf.py (руководство разработчика, PDF). Сам загрузчик
# src/its_pdf_loader.py и обёртка tools/load_its_pdf.py трекаются.
_its_pdf_*.txt
# Логи прогонов карантина сниппетов (узел Q1-Q3): tools/check_quarantine_round_trip.py
# (_q3_*.txt) и tools/purge_marked_snippets.py (_purge_*.txt). Сами скрипты трекаются:
# tools/check_quarantine_round_trip.py, tools/purge_marked_snippets.py.
_q3_*.txt
_purge_*.txt
# --- Логи одноразовых замеров 19–20.10.2026 (COM/ibcmd apply/DCS, профили свойств) ---
# Нормативы ссылаются на имена логов как на доказательства замера (`_d3_apply_full.txt`,
# `_d8_apply2.txt`, `_d9_session_meta_check.txt`), но сами логи в репозиторий не входят —
# по тому же правилу, что `_q3_*.txt` и `_v*.txt`. Исключение осознанное: скрипт-проверка,
# на которую норматив ссылается как на воспроизводимую, трекается — `_d10_state_note.py`.
_d*.txt
_p*.txt
_its_5450.txt
tools/_d*_out.txt

# --- Логи прогонов 22–24.10.2026 (сверка текстов правил, слой core-правил,
#     применение миграций, замеры колонок заголовка) ---
# Правило то же, что в блоках выше: нормативы ссылаются на скрипты проверок
# (tools/check_search_rules_sync.py, tools/check_mcp_tool_wiring.py,
# tools/migrate_core_rules_to_layer.py), а их вывод остаётся локально.
# Шаблоны закрывают ровно те имена, что плодились в корне при этих прогонах;
# скрипты-зонды узлов (например _v46*, _v47*) шаблонами не закрываются — их
# судьба решается вместе с коммитом соответствующего узла.
_cmp_ddl_*.txt
_mtw_now.txt
_final_validator.txt
_breakdown_*.txt
_layer_*.txt
_head_*.txt
_index_titles.txt
_work_headings.txt
_mig_dry.txt
_mig_apply.txt
_rl_*.txt
_git_st.txt
_f1.txt
_*_answer.txt

# Слой правил MCP живёт строками local_doc (категории *-rules), а не файлами.
# Снимок карточек (--dump у мигратора), архив прежних текстов правил (ARCHIVE_DIR
# в src/rules_layer.py) и дампы разбора plan_rule_sections.py — локальные артефакты
# переноса: их не читает ни один инструмент контракта, а достижимость карточки и
# совпадение строки БД с исходником docs/rules/*.md проверяет
# tools/check_rules_layer.py адресом. Ссылки на эти каталоги из правил убраны
# (узел RULE-V2) — иначе правило ссылалось бы на файл, которого в репозитории нет.
layers/
Arhiv_Rules/
snapshots/rule_plans/

# Лог обращения к правилам (пишет tools/rules_logging.py, читает он же): сессии вида
# «обращение — заголовок карточки — время — итог». В репозиторий не входит: это наблюдение
# за прогонами ассистента, а не артефакт контракта и не доказательство замера, на которое
# ссылается норматив. `*.log` выше закрывает сам файл; каталог закрывается отдельно, чтобы
# в него случайно не лёг снимок, который начнут читать как правило.
logs/

# Снимки и временные выгрузки прогонов (решение оператора 27.10.2026 по открытому вопросу узла
# RESTRUCTURE-LAYERS). Файлы остаются на диске — это рабочие материалы замера; в репозиторий они
# не входят по той же причине, что `layers/`, `Arhiv_Rules/` и `logs/`: снимок не является правилом
# и не является доказательством замера, на которое ссылается норматив. Отдельная строка про
# резервную копию БД закрывает вопрос о файле `_backup_local_doc_*.sql` (108 МБ на момент
# решения): копия нужна под рукой при разборе, но её вес не должен попадать в историю репозитория.
Reports/
_backup_local_doc_*.sql
/_chk.txt
/_chk_root.err
/_edit_core.txt
/_edit_kb.txt
/_gen_card.txt
/_reading_card.txt
/_root_card.txt

# --- Дампы прогонов в корне (узел П6 плана `docs/RULES_CONTEXT_PLAN.md`) ---
# Правило то же, что в блоках выше: скрипт проверки или зонд трекается, потому что он
# воспроизводит замер, а его вывод остаётся на диске. Отдельные шаблоны выше закрывали ровно те
# имена, что плодились при конкретных прогонах (`_v*.txt`, `_d*.txt`, `_layer_*.txt`, `_q3_*.txt`),
# и к 27.10.2026 в индексе всё равно лежал 51 дамп: `_func_dump.txt`, `_l3_probe.txt`,
# `_src_layercards.txt`, `_t_*.txt`, `_old_addrs*.txt`, `_v46_props_*.json` и другие. Шаблон
# закрывает класс имён целиком: файл вида `_имя.txt` / `_имя.json` в корне — вывод замера, а не
# исходник. Скрипты `_*.py`, `_*.sql`, `_*.ps1` шаблоном не закрываются — они и есть
# воспроизводимые измерители. Каталог `_scratch/` закрывается отдельной строкой: под тем же
# правилом в нём лежали `_sync_before.txt` / `_sync_after.txt` / `_sync_final.txt`.
/_*.txt
/_*.json
/_scratch/

# --- Дампы текстов карточек правил (узел V54, шаг П5) ---
# Каталоги-выводы: `_v54_raw/` — сырой текст карточек слоя, который пишет
# `_v54_p5_card_dump.py` (его же читает `_v54_p5_rules_card.py`, собирая якоря правок),
# `_v54_rules/` — фрагменты новых текстов карточек. Правило то же, что для `/_*.txt`,
# `layers/` и `Arhiv_Rules/`: зонд, воспроизводящий замер, трекается, а его вывод остаётся на
# диске — снимок карточки не является правилом и не является доказательством замера, на которое
# ссылается норматив. Отдельные строки, а не общий шаблон каталога: под каталогами-выводами не
# должно появляться исходников.
_v54_raw/
_v54_rules/


